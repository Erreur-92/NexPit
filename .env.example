# ---------------------------------------------------------------------------
# Copier ce fichier en .env.local et remplir. Rien n'est optionnel côté SMTP :
# sans lui, les formulaires refusent l'envoi au lieu d'échouer en silence.
# ---------------------------------------------------------------------------

# URL publique du site, sans barre oblique finale.
# Sert à construire les liens des emails (confirmation, désinscription,
# annulation de rendez-vous) et les URL canoniques. En développement, mettre
# http://localhost:3000 pour que les liens reçus par email pointent en local.
NEXT_PUBLIC_SITE_URL=https://www.nexpit.fr

# --- Envoi d'emails --------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# true uniquement sur le port 465 ; sur 587 la connexion passe en STARTTLS.
SMTP_SECURE=false
SMTP_USER=
# Mot de passe d'application, pas le mot de passe du compte.
SMTP_PASS=
# Adresse d'expédition. Gmail réécrit ce champ si ce n'est pas le compte
# authentifié ou un alias vérifié dans « Envoyer des emails en tant que ».
SMTP_FROM=

# --- Adresses ---------------------------------------------------------------
# Adresse affichée publiquement sur le site.
NEXT_PUBLIC_CONTACT_EMAIL=contact@nexpit.fr
# Boîte interne qui reçoit les demandes et les notifications de rendez-vous.
CONTACT_NOTIFY_TO=

# --- Stockage ---------------------------------------------------------------
# Répertoire du fichier de données (inscriptions et rendez-vous).
# Doit être persistant : sur un hébergement conteneurisé, monter un volume.
# Par défaut : <racine du projet>/.data
DATA_DIR=

# --- Rappels de rendez-vous -------------------------------------------------
# Secret attendu par /api/cron/reminders, en en-tête Authorization: Bearer …
# Tant qu'il est vide, la route répond 503 et aucun rappel n'est envoyé.
# Générer avec : openssl rand -base64 32
CRON_SECRET=

# --- Mesure d'audience (facultatif) ----------------------------------------
# Laisser vide pour n'avoir aucun traceur du tout.
# Le script n'est chargé qu'après acceptation explicite du visiteur.
# Exemple Umami auto-hébergé : https://votre-umami/script.js
# Exemple Plausible auto-hébergé : https://votre-plausible/js/script.js
NEXT_PUBLIC_ANALYTICS_SRC=
# Identifiant du site chez le fournisseur choisi.
NEXT_PUBLIC_ANALYTICS_SITE_ID=

# --- Cartouche du pied de page (facultatif) --------------------------------
# Repère de révision affiché dans le bloc-titre. Par exemple le hash court du
# commit, injecté au build : NEXT_PUBLIC_BUILD_REV=$(git rev-parse --short HEAD)
NEXT_PUBLIC_BUILD_REV=
